<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Av1rt.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Native AOT compiles Avx2 code paths only when AVX2 is part of the instruction-set
         baseline; without it the SIMD kernels are unavailable (Simd.UseAvx2 is false). -->
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>
    <!-- Otherwise restore downloads the Windows Desktop and ASP.NET Core runtime packs (175 MB),
         which the CLI does not use. -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>

  <!-- The SIMD kernels are large AggressiveInlining bodies behind thin dispatch forwarders. The
       JIT's inline budget is a multiple of the root method's size, so with the default (10) the
       kernels' own helper intrinsics stop being inlined; 50 lets every forced inline through
       (+12% at 4K; 100 and 200 produce the identical binary). -->
  <PropertyGroup>
    <JitInlineBudget Condition="'$(JitInlineBudget)' == ''">50</JitInlineBudget>
  </PropertyGroup>
  <!-- The JIT stops inlining into a method once it has JitMaxLocalsToTrack (1024) locals and
       stops tracking (enregistering) locals beyond it. Each inlined intrinsic wrapper or Ptr
       operation adds a few temps, so the large ported kernels (subpel variance, convolve,
       forward transforms) hit the limit: the rest of their wrapper calls stayed real calls and
       their vectors lived in a big zero-initialised stack frame. 16384 lifts it (+13% at 1T). -->
  <PropertyGroup>
    <JitMaxLocalsToTrack Condition="'$(JitMaxLocalsToTrack)' == ''">16384</JitMaxLocalsToTrack>
  </PropertyGroup>
  <ItemGroup>
    <IlcArg Include="--codegenopt:JitInlineBudget=$(JitInlineBudget)" />
    <IlcArg Include="--codegenopt:JitMaxLocalsToTrack=$(JitMaxLocalsToTrack)" />
    <!-- Diagnostics: ExtraIlcArgs, semicolon (%3B) separated ILC arguments such as codegenopt JitDisasm. -->
    <IlcArg Include="$([MSBuild]::Unescape($(ExtraIlcArgs)))" Condition="'$(ExtraIlcArgs)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Av1rt\Av1rt.csproj" />
    <ProjectReference Include="..\..\src\SIPSorceryMedia.AV1\SIPSorceryMedia.AV1.csproj" />
  </ItemGroup>

</Project>
